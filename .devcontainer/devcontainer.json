{
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "customizations": {
    "vscode": {
      "settings": {
        "[typescript]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode",
          "editor.formatOnSave": true
        },
        "[json]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode",
          "editor.formatOnSave": true
        },
        "[jsonc]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode",
          "editor.formatOnSave": true
        }
      },
      "extensions": [
        "dbaeumer.vscode-eslint",
        "vitest.explorer",
        "esbenp.prettier-vscode",
        "streetsidesoftware.code-spell-checker"
      ]
    }
  },
  "forwardPorts": [3000],
  "containerUser": "vscode",
  "containerEnv": {
    "PATH": "/home/vscode/.bun/bin:${containerEnv:PATH}"
  },
  // Bun is the only runtime and package manager of the monorepo
  "postCreateCommand": "curl -fsSL https://bun.sh/install | bash -s bun-v1.4.1 && /home/vscode/.bun/bin/bun install",
  "waitFor": "postCreateCommand", // otherwise automated tests fail
  "features": {
    "github-cli": "latest"
  }
}
