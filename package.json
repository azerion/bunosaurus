{
  "name": "root",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "packages/*",
    "argos",
    "website",
    "packages/create-docusaurus/templates/*",
    "admin/scripts",
    "admin/test-bad-package",
    "admin/new.docusaurus.io",
    "bench-sites/*"
  ],
  "scripts": {
    "start": "bun run build:packages && bun run start:website",
    "start:website": "bun run --filter website start",
    "start:website:profile": "DOCUSAURUS_BUNDLER_CPU_PROFILE=true DOCUSAURUS_RSPACK_TRACE=true bun run --filter website start",
    "start:website:baseUrl": "bun run --filter website start:baseUrl",
    "start:website:blogOnly": "bun run --filter website start:blogOnly",
    "start:website:deployPreview": "cross-env NETLIFY=true CONTEXT='deploy-preview' bun run --filter website start",
    "examples:generate": "bun admin/scripts/generateExamples.js",
    "build": "bun run build:packages && bun run build:website",
    "build:packages": "bun run --filter './packages/*' build",
    "build:website": "bun run --filter website build",
    "build:website:profile": "DOCUSAURUS_BUNDLER_CPU_PROFILE=true DOCUSAURUS_RSPACK_TRACE=true bun run --filter website build",
    "build:website:baseUrl": "bun run --filter website build:baseUrl",
    "build:website:blogOnly": "bun run --filter website build:blogOnly",
    "build:website:deployPreview:testWrap": "bun run --filter website test:swizzle:wrap:ts",
    "build:website:deployPreview:build": "cross-env NETLIFY=true CONTEXT='deploy-preview' bun run --filter website build",
    "build:website:deployPreview": "bun run build:website:deployPreview:testWrap && bun run build:website:deployPreview:build",
    "build:website:fast": "bun run --filter website build:fast",
    "build:website:en": "bun run --filter website build --locale en",
    "profile:bundle:cpu": "bun run --filter website profile:bundle:cpu:profile",
    "profile:bundle:samply": "bun run --filter website profile:bundle:samply",
    "clear:website": "bun run --filter website clear",
    "serve:website": "bun run --filter website serve",
    "serve:website:baseUrl": "serve website",
    "serve:website:ssl": "bun run serve:website:ssl:gencert && bun run serve:website:ssl:message && bun run serve:website:ssl:serve",
    "serve:website:ssl:gencert": "openssl req -x509 -nodes -days 365 -newkey rsa:4096 -subj \"/C=US/ST=Docusaurus/L=Anywhere/O=Dis/CN=localhost\" -keyout ./website/.docusaurus/selfsigned.key -out ./website/.docusaurus/selfsigned.crt",
    "serve:website:ssl:message": "echo '\n\n\nServing Docusaurus with HTTPS on localhost requires to disable the Chrome security: chrome://flags/#allow-insecure-localhost\n\n\n'",
    "serve:website:ssl:serve": "serve website/build --ssl-cert ./website/.docusaurus/selfsigned.crt --ssl-key ./website/.docusaurus/selfsigned.key",
    "crowdin:upload:website": "crowdin upload sources --config ./crowdin-v2.yaml",
    "crowdin:download": "crowdin download --config ./crowdin-v2.yaml",
    "crowdin:download:website": "bun run crowdin:download --language fr --language ko --language pt-BR --language zh-CN --language ja",
    "argos": "bun run argos:build && bun run argos:screenshot && bun run argos:build:text-snapshots && bun run argos:format:text-snapshots && bun run argos:upload:text-snapshots",
    "argos:build": "cross-env DOCUSAURUS_ARGOS_BUILD=true bun run build:website:fast --dev",
    "argos:screenshot": "bun run --filter argos screenshot",
    "argos:build:text-snapshots": "cross-env DOCUSAURUS_ARGOS_BUILD=true SKIP_HTML_MINIFICATION=true bun run build:website:fast --dev --no-minify",
    "argos:format:text-snapshots": "bun argos/normalizeTextSnapshots.mjs && bun run format:website:build",
    "argos:upload:text-snapshots": "bun run --filter argos upload-text-snapshots",
    "changelog": "lerna-changelog",
    "postinstall": "bun run build:packages",
    "prepare": "husky",
    "format": "oxfmt .",
    "format:website:build": "oxfmt --config .oxfmtrc.website.build.json website/build",
    "format:diff": "oxfmt --list-different .",
    "lint": "bun run lint:js && bun run lint:style && bun run lint:spelling && bun run lint:syncpack && bun run lint:knip",
    "lint:ci": "bun run lint:js --quiet && bun run lint:style && bun run lint:spelling && bun run lint:syncpack && bun run lint:deps && bun run lint:knip",
    "lint:js": "eslint --cache --report-unused-disable-directives \"**/*.{js,jsx,ts,tsx,mjs}\"",
    "lint:js:fix": "bun run lint:js --fix",
    "lint:spelling": "cspell \"**\" --no-progress --show-context --show-suggestions",
    "lint:spelling:fix": "rimraf project-words.txt && echo \"# Project Words - DO NOT TOUCH - This is updated through CI\" >> project-words.txt && bun run --silent lint:spelling --words-only --unique --no-exit-code --no-summary \"**\" | cross-env LC_ALL=C sort --ignore-case >> project-words.txt",
    "lint:style": "stylelint \"**/*.css\"",
    "lint:style:fix": "bun run lint:style --fix",
    "lint:syncpack": "syncpack lint",
    "lint:syncpack:fix": "syncpack fix",
    "lint:deps": "bun install --frozen-lockfile --dry-run",
    "lint:knip": "knip",
    "lint:knip:fix": "knip --fix",
    "test": "bun --bun vitest run",
    "test:build:website": "./admin/scripts/test-release.sh",
    "watch": "bun run --parallel --filter './packages/*' watch",
    "clear": "(bun run --filter website clear || echo 'Failure while running docusaurus clear') && rimraf test-website test-website-in-workspace 'packages/*/lib' '!packages/docusaurus/lib'",
    "test:baseUrl": "bun run build:website:baseUrl && bun run serve:website:baseUrl",
    "lock:update": "bun install --lockfile-only",
    "update-translations": "bun run --filter @docusaurus/theme-translations update"
  },
  "devDependencies": {
    "@ai-sdk/react": "^3.0.280",
    "@crowdin/cli": "^5.0.2",
    "@docusaurus/eslint-plugin": "workspace:*",
    "@docusaurus/fs": "workspace:*",
    "@docusaurus/monorepo-scripts": "workspace:*",
    "@docusaurus/plugin-content-blog": "workspace:*",
    "@docusaurus/plugin-content-docs": "workspace:*",
    "@docusaurus/plugin-content-pages": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "1.4.1",
    "@types/lodash": "^4.17.25",
    "@types/node": "^26.6.1",
    "@types/prompts": "^2.4.9",
    "@types/react": "^19.3.0",
    "@types/semver": "^7.8.0",
    "@typescript/native": "npm:typescript@~7.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/eslint-plugin": "^1.6.27",
    "cross-env": "^10.1.0",
    "cspell": "^10.3.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-eslint-plugin": "^7.6.2",
    "eslint-plugin-header": "^3.1.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-you-might-not-need-an-effect": "^1.0.2",
    "eslint-plugin-regexp": "^3.3.0",
    "globals": "^17.12.0",
    "happy-dom": "20",
    "husky": "^9.1.7",
    "jest-serializer-ansi-escapes": "^5.0.0",
    "jest-serializer-react-helmet-async": "^1.0.21",
    "jiti": "^2.7.0",
    "knip": "^6.36.0",
    "lerna-changelog": "^2.2.0",
    "lint-staged": "^17.5.0",
    "lodash": "^4.18.1",
    "npm-run-all": "^4.1.5",
    "oxfmt": "^0.47.0",
    "pkg-pr-new": "^0.0.75",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-helmet-async": "npm:@slorber/react-helmet-async@1.3.0",
    "rimraf": "^6.1.3",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-copyright": "workspace:*",
    "syncpack": "^15.3.3",
    "typescript": "npm:@typescript/typescript6@~6.0.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "packageManager": "bun@1.4.1",
  "engines": {
    "bun": ">=1.4.1"
  },
  "overrides": {
    "axios": "1.16.1",
    "tar": "^7.5.16",
    "sharp": "^0.35.1"
  },
  "trustedDependencies": [
    "@parcel/watcher"
  ],
  "changelog": {
    "repo": "facebook/docusaurus",
    "labels": {
      "pr: breaking change": ":boom: Breaking Change",
      "pr: new feature": ":rocket: New Feature",
      "pr: bug fix": ":bug: Bug Fix",
      "pr: performance": ":zap: Performance",
      "pr: polish": ":nail_care: Polish",
      "pr: documentation": ":memo: Documentation",
      "pr: dependencies": ":robot: Dependencies",
      "pr: maintenance": ":wrench: Maintenance",
      "pr: translations": ":globe_with_meridians: Translations"
    },
    "cacheDir": ".changelog"
  },
  "patchedDependencies": {
    "vitest@5.0.3": "patches/vitest@5.0.3.patch"
  }
}
